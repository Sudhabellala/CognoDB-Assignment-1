# Copy this file to .env and fill in your real values. .env is gitignored — never commit secrets.

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your generated password>

# --- Neo4j (self-hosted via docker-compose) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmarkpass

# --- Memgraph (self-hosted via docker-compose) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB (self-hosted via docker-compose) ---
ARANGODB_HOST=localhost
ARANGODB_PORT=8529
ARANGODB_USER=root
ARANGODB_PASSWORD=benchmarkpass
ARANGODB_DB=benchmark

# --- Dgraph (self-hosted via docker-compose) ---
DGRAPH_HOST=localhost
DGRAPH_PORT=9080
